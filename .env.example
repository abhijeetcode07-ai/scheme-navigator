# Server-side only (Vercel Project Settings → Environment Variables)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Feed ingestion & Cron settings
NEWS_FEED_URLS=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=1,https://government.economictimes.indiatimes.com/rss/education
FEED_REFRESH_SECRET=your_secret_for_manual_refresh
CRON_SECRET=your_vercel_cron_secret

# Supabase Server-side (Required for /api/feed and /api/schemes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase Client-side (Publicly accessible in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

